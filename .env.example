
# ────────────────────────────────────────────────
# LLM Configuration
# ────────────────────────────────────────────────

LLM_PROVIDER=openrouter          # or: ollama

# ── OpenRouter ──────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=qwen/qwen2.5-72b-instruct
# Alternative strong models:
# OPENROUTER_MODEL=qwen/qwen3-235b-a22b
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_MODEL=anthropic/claude-3-5-sonnet-20241022

# ── Ollama (fallback / local) ───────────────────
OLLAMA_MODEL=mistral
# OLLAMA_BASE_URL=http://localhost:11434   # usually not needed

# ── Generation parameters ───────────────────────
TEMPERATURE=0.25
MAX_TOKENS=2048

# ── Retrieval tuning ────────────────────────────
RETRIEVER_K=8
SEARCH_TYPE=mmr                  # or: similarity

# Hybrid search (semantic vector + BM25 keyword)
# BM25 improves recall for exact names, acronyms, and Arabic queries
USE_HYBRID_SEARCH=true
HYBRID_SEMANTIC_WEIGHT=0.7       # 0.0 = pure BM25, 1.0 = pure semantic

# Re-ranker (cross-encoder applied after retrieval)
# Retrieves k * RERANK_FACTOR candidates, reranks, keeps top k
USE_RERANKER=true
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_FACTOR=3

CHROMA_TELEMETRY_IMPL=none
CHROMA_TELEMETRY=false

# ────────────────────────────────────────────────
# Opik (Comet) Observability
# ────────────────────────────────────────────────
# Set OPIK_ENABLED=false to disable tracing entirely (e.g. local dev / CI)
OPIK_ENABLED=true
OPIK_PROJECT_NAME=tunisia-rag

# ── Cloud (Comet) ───────────────────────────────
# OPIK_API_KEY=your-opik-api-key
# Optional: set your Comet workspace name
# OPIK_WORKSPACE=your-workspace

# ── Self-hosted local instance ──────────────────
# Set USE_LOCAL=true and optionally override the default URL (http://localhost:5173)
OPIK_USE_LOCAL=true
OPIK_WORKSPACE=your-workspace-name
# OPIK_URL_OVERRIDE=http://localhost:5173

# ────────────────────────────────────────────────
# Arize Phoenix Observability
# ────────────────────────────────────────────────
PHOENIX_ENABLED=true
PHOENIX_PROJECT_NAME=tunisia-rag
# Local mode (default) — no API key needed, UI at http://localhost:6006
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# Cloud mode — sign up at https://app.phoenix.arize.com
# PHOENIX_API_KEY=your-phoenix-api-key
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/v1/traces

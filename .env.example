# ────────────────────────────────────────────────
# LLM Configuration
# ────────────────────────────────────────────────

LLM_PROVIDER=openrouter          # or: ollama

# ── OpenRouter ──────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=qwen/qwen2.5-72b-instruct
# Alternative strong models:
# OPENROUTER_MODEL=qwen/qwen3-235b-a22b
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_MODEL=anthropic/claude-3-5-sonnet-20241022

# ── Ollama (fallback / local) ───────────────────
OLLAMA_MODEL=mistral
# OLLAMA_BASE_URL=http://localhost:11434   # usually not needed

# ── Generation parameters ───────────────────────
TEMPERATURE=0.25
MAX_TOKENS=2048

# ── Retrieval tuning ────────────────────────────
RETRIEVER_K=8
SEARCH_TYPE=similarity           # or: mmr

CHROMA_TELEMETRY_IMPL=none
CHROMA_TELEMETRY=false